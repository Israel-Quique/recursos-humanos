APP_NAME=RecursosHumanos
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/La_Paz
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@recursoshumanos.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ADMIN_EMAIL=admin@recursoshumanos.local
ADMIN_PASSWORD=admin12345

ASISTENCIA_HORA_ENTRADA=08:30:00
ASISTENCIA_HORA_SALIDA=16:30:00
ASISTENCIA_HORAS_JORNADA=8
ASISTENCIA_PASSWORD_INICIAL=changeme123
ASISTENCIA_TOLERANCIA_MIN=30
PYTHON_BIN=python

BIOMETRICO_DRIVER=archivo
BIOMETRICO_HOST=
BIOMETRICO_PORT=
BIOMETRICO_USERNAME=
BIOMETRICO_PASSWORD=
BIOMETRICO_DATABASE=
BIOMETRICO_TABLE=
BIOMETRICO_PULL_INTERVAL=60
BIOMETRICO_TIMEOUT=2
BIOMETRICO_DEVICES=[]
# Ejemplo:
# BIOMETRICO_DEVICES=[{"department":"La Paz","branch":"Oficina Central","ip":"172.65.14.108","port":4370},{"department":"Santa Cruz","branch":"Regional Santa Cruz","ip":"172.65.20.15","port":4370}]
# Alternativa simple:
# BIOMETRICO_DEVICE_LIST=La Paz|Oficina Central|172.65.14.108|4370;Santa Cruz|Regional Santa Cruz|172.65.20.15|4370
